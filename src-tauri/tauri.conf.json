{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoBookMarkManager",
  "version": "1.0.0",
  "identifier": "com.kisknsmr.neobookmarkmanager",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeoBookMarkManager",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/*": "icons/"
    },
    "publisher": "kisknsmr",
    "copyright": "Copyright (c) 2026 kisknsmr. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "ブックマーク整理ツール",
    "longDescription": "ブックマークHTML（Netscape形式）を読み込み、整理・情報の補完・タグ付け・AI分類・リンク切れチェックを行うポータブルなデスクトップアプリ。",
    "licenseFile": "../LICENSE"
  }
}
