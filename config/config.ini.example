[API]
# 通常使うキー。環境変数 (GENAI_API_KEY / GOOGLE_API_KEY) の方が優先されます。
# api_key = YOUR_API_KEY_HERE
#
# 有料枠（請求先アカウントを紐付けたプロジェクト）のキー。任意。
# 分類はまず上の api_key で実行し、無料枠の上限で止まったときだけ、
# 確認のうえこちらへ切り替えて残りを続行します。勝手には切り替わりません。
# 枠はキー（プロジェクト）単位で決まるため、使い分けにはキーが2本必要です。
# 環境変数 GENAI_PAID_API_KEY でも指定できます。
# paid_api_key = YOUR_PAID_API_KEY_HERE

[Proxy]
# url = http://proxy.example.com:8080
# user =
# password =

[Prompt]
prompt_file = config/prompt.txt

[Classifier]
priority_terms = Python, Power BI, SharePoint, AWS

[AI]
# モデル名（google-generativeai）
model = gemini-2.5-flash-lite
# 1回のリクエストに含める件数（既定150。大きいほど全体を見て分類できる）
chunk_size = 150
# 送信前サニタイズ（クエリ除去）: true/false
sanitize_urls = true
# 上の api_key が無料枠かどうかの自己申告: true/false（未設定なら「未申告」）
# API からは問い合わせられないため、ユーザーの申告に頼っています。
# true にすると、見積もり画面が「無料枠のため請求されません」と表示します。
# ※ 無料枠では送信内容が Google の製品改善に利用され、人間のレビュアーが
#    読む場合があります。規約上も機微情報の送信は禁止されています。
# free_tier = true
# コスト承認ゲート用（USD / 1M tokens）のフォールバック。
# ※ 通常は config/models.json のモデル別価格が使われます。ここの値は
#    models.json に載っていないモデルを指定したときだけ参照されます。
# ※ どちらからも単価が得られない場合は、安全側でAI実行を停止します。
input_cost_per_1m_tokens = 0.10
output_cost_per_1m_tokens = 0.40

[AutoTag]
# 将来的にドメイン辞書/キーワード辞書をここから読み込む想定（今回はハードコード実装）。
# allow_network = false

[Network]
# タイトル更新・説明文取得の同時並列数（1〜20）。未設定なら LinkCheck.concurrency → 5。
# 大きいほど速いが、相手サーバ/プロキシへの負荷とタイムアウト誤検知が増える。
concurrency = 8

[LinkCheck]
# チェックをスキップするURLパターン（カンマ区切り、部分一致）
# イントラネット・ローカルアドレス・特殊スキームなどを指定
# 例: 10.*, 192.168.*, *.local, intranet, file://, javascript:
exclude_patterns = 10.*, 192.168.*, 172.16.*, *.local, localhost, file://, javascript:, about:
# 接続タイムアウト（秒）
timeout_secs = 10
# 同時チェック数
concurrency = 5

[Organize]
# 重複削除で除外するURL（カンマ区切り）。これらは何件あっても削除されません。
dedupe_exclude_urls = http://bookmark.placeholder.url/

[Session]
# last_bookmarks_file = samples/bookmarks_2026_01_10.html
# window_width = 1400
# window_height = 800
